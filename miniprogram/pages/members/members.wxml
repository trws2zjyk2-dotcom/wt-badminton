<view class="container">
  <view class="card">
    <view class="header-bar">
      <text class="label-text">会员列表</text>
      <button class="btn btn-primary btn-sm" bindtap="onAddMember">+ 新增会员</button>
    </view>
    <view class="search-box">
      <input class="form-input" placeholder="搜索会员名称..." value="{{keyword}}" bindinput="onSearchInput" />
    </view>
  </view>

  <block wx:if="{{members.length}}">
    <view
      wx:for="{{members}}"
      wx:key="id"
      class="list-item"
      data-id="{{item.id}}"
      bindtap="onMemberTap"
    >
      <view class="name">{{item.name}}</view>
      <view class="meta">价格表 {{item.priceTable}} · 余额 {{item.balanceText}}</view>
    </view>
  </block>
  <view wx:else class="empty-state">暂无会员，点击上方新增</view>
</view>

<view class="modal-mask" wx:if="{{showMemberModal}}" bindtap="closeMemberModal">
  <view class="modal-panel" catchtap="stopBubble">
    <view class="modal-title">{{modalTitle}}</view>
    <view class="form-group">
      <text class="form-label">会员名称</text>
      <input class="form-input" maxlength="30" value="{{memberName}}" bindinput="onMemberNameInput" />
    </view>
    <view class="form-group">
      <text class="form-label">会员价格表</text>
      <picker range="{{priceTableLabels}}" value="{{priceTableIndex}}" bindchange="onPriceTableChange">
        <view class="form-input">{{selectedPriceTableLabel}}</view>
      </picker>
    </view>
    <view class="form-group" wx:if="{{!isEdit}}">
      <text class="form-label">初始余额（元）</text>
      <input class="form-input" type="number" value="{{balance}}" bindinput="onBalanceInput" />
    </view>
    <view class="modal-actions">
      <button class="btn btn-secondary" bindtap="closeMemberModal">取消</button>
      <button class="btn btn-primary" bindtap="saveMember">保存</button>
    </view>
  </view>
</view>
