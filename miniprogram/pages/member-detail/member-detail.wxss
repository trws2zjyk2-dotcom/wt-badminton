.receipt-value {
  font-weight: 700;
}

.receipt-value.highlight {
  color: #0ea5e9;
}

.recharge-tiers {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.recharge-tier-btn {
  flex: 1;
  min-width: 180rpx;
  margin: 0;
  padding: 16rpx 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #1e293b;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 12rpx;
}

.recharge-tier-btn.active {
  color: #0284c7;
  background: #e0f2fe;
  border-color: #0ea5e9;
}

.recharge-preview {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #065f46;
  background: #ecfdf5;
  border: 1px solid #a7f3d0;
  border-radius: 12rpx;
}
