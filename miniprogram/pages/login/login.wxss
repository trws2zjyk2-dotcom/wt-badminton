.login-page {
  min-height: 100vh;
  background: linear-gradient(160deg, #0ea5e9 0%, #0369a1 100%);
  padding: calc(env(safe-area-inset-top) + 120rpx) 48rpx 60rpx;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  color: #fff;
  margin-bottom: 60rpx;
}

.logo {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  opacity: 0.85;
  margin-top: 12rpx;
}

.login-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.login-btn {
  width: 100%;
  margin-top: 20rpx;
  padding: 24rpx;
  font-size: 32rpx;
}

.login-tip {
  margin-top: 48rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  line-height: 2;
  display: flex;
  flex-direction: column;
}

.tip-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  opacity: 0.7;
}
