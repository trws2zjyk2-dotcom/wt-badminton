page {
  background: #f1f5f9;
  color: #1e293b;
  font-size: 28rpx;
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
  padding-bottom: 40rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

.toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.toolbar-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.label-text {
  color: #64748b;
  font-size: 24rpx;
}

.badge {
  font-size: 22rpx;
  color: #0284c7;
  background: #e0f2fe;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 12rpx 0;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  border: 1rpx solid #cbd5e1;
}

.dot.available { background: #fff; }
.dot.locked { background: #fef3c7; border-color: #f59e0b; }
.dot.walkin { background: #dbeafe; border-color: #3b82f6; }
.dot.online { background: #ede9fe; border-color: #8b5cf6; }
.dot.closed { background: #f1f5f9; border-color: #cbd5e1; }

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: none;
  line-height: 1.4;
}

.btn-primary {
  background: #0ea5e9;
  color: #fff;
}

.btn-secondary {
  background: #e2e8f0;
  color: #334155;
}

.btn-danger {
  background: #ef4444;
  color: #fff;
}

.btn-sm {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
}

.table-scroll {
  width: 100%;
  white-space: nowrap;
}

.grid-table {
  display: inline-block;
  min-width: 100%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #e2e8f0;
}

.grid-row {
  display: flex;
  border-bottom: 1rpx solid #e2e8f0;
}

.grid-row:last-child {
  border-bottom: none;
}

.grid-row.header {
  background: #f8fafc;
  position: sticky;
  top: 0;
  z-index: 2;
}

.grid-cell {
  flex-shrink: 0;
  width: 140rpx;
  min-height: 88rpx;
  padding: 8rpx;
  border-right: 1rpx solid #e2e8f0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  text-align: center;
  box-sizing: border-box;
}

.grid-cell:last-child {
  border-right: none;
}

.grid-cell.corner {
  width: 120rpx;
  font-weight: 600;
  color: #475569;
}

.grid-cell.court-name {
  width: 120rpx;
  font-weight: 600;
  background: #f8fafc;
  font-size: 22rpx;
}

.grid-cell.closed-col {
  background: #f1f5f9;
  color: #94a3b8;
}

.grid-cell.closed {
  background: #f1f5f9;
  color: #94a3b8;
}

.grid-cell.available {
  background: #fff;
}

.grid-cell.available:active {
  background: #e0f2fe;
}

.grid-cell.locked {
  background: #fef3c7;
  border-color: #f59e0b;
}

.grid-cell.walkin {
  background: #dbeafe;
}

.grid-cell.online {
  background: #ede9fe;
}

.grid-cell.vip-row {
  background: #fffbeb;
}

.grid-cell.vip-row.locked {
  background: #fde68a;
}

.cell-name {
  font-size: 20rpx;
  font-weight: 600;
  color: #1e293b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 120rpx;
}

.cell-price {
  font-size: 18rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.cell-hint {
  font-size: 18rpx;
  color: #94a3b8;
}

.pending-tag {
  font-size: 16rpx;
  color: #b45309;
  margin-top: 2rpx;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-panel {
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.form-info {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #475569;
}

.form-group {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.form-input {
  width: 100%;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
}

.price-preview {
  background: #f0f9ff;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #0369a1;
  margin-top: 12rpx;
}

.price-preview.error {
  background: #fef2f2;
  color: #dc2626;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.modal-actions .btn {
  flex: 1;
}

.warning-text {
  color: #b45309;
  font-size: 24rpx;
  margin: 12rpx 0;
}

.empty-state {
  text-align: center;
  color: #94a3b8;
  padding: 80rpx 40rpx;
  font-size: 28rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.summary-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

.summary-card .label {
  font-size: 22rpx;
  color: #64748b;
}

.summary-card .value {
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.summary-card .value.green {
  color: #10b981;
}

.list-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

.list-item .name {
  font-size: 30rpx;
  font-weight: 600;
}

.list-item .meta {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.search-box {
  margin-bottom: 16rpx;
}

.income-row {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
}

.income-row .row-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.income-row .amount {
  font-weight: 700;
  color: #0ea5e9;
}

.income-row .row-meta {
  color: #64748b;
  font-size: 22rpx;
}

.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.header-bar .user-info {
  font-size: 22rpx;
  color: #64748b;
}

.logout-link {
  color: #ef4444;
  font-size: 24rpx;
}
