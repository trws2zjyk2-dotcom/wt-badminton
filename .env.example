# 复制为 .env 后修改（本地开发用）
# 在线部署请在 Render 后台填写环境变量，见 ONLINE.md

# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成强密码
ADMIN_NAME=系统管理员

# 会话密钥
SESSION_SECRET=请改成随机长字符串

# Supabase 云数据库（在线部署推荐，见 ONLINE.md）
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

PORT=3000

# HTTP 部署（无 HTTPS）须设为 false，否则登录后 cookie 无法保存
SESSION_SECURE=false
